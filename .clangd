CompileFlags:
  Add:
    - /std:c++23preview
    - -fms-extensions
    - -fms-compatibility
    - -fms-compatibility-version=19.30
    - -fexceptions
    - -fcxx-exceptions
  Remove:
    - /W*
    - /w*
    - /MD*
    - /MT*
    - /FS
    - /nologo
    - /Fd*
    - /Fo*
    - /Zi

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - typename_nested_not_found
    - default_member_initializer_not_yet_parsed

Completion:
  AllScopes: Yes
  ArgumentLists: None
  HeaderInsertion: Never
  CodePatterns: None

InlayHints:
  BlockEnd: Yes
  TypeNameLimit: 32

Hover:
  ShowAKA: Yes
