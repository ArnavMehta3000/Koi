CompileFlags:
  Add:
    - -clang:-std=c++23
    - -fms-extensions
    - -fms-compatibility
    - -fms-compatibility-version=19.30
    - -fexceptions
    - -fcxx-exceptions
    - -Wno-missing-field-initializers
  Remove:
    - /W*
    - /w*
    - /MD*
    - /MT*
    - /FS
    - /nologo
    - /Fd*
    - /Fo*
    - /Zi
    - /Yu*
    - /Yc*
    - /Fp*
    - /FI*

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - typename_nested_not_found
    - default_member_initializer_not_yet_parsed

Completion:
  AllScopes: true
  ArgumentLists: None
  HeaderInsertion: Never
  CodePatterns: None

InlayHints:
  BlockEnd: false
  TypeNameLimit: 32
  ParameterNames: false

Hover:
  ShowAKA: true
