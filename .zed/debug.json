// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger

[
  {
    "label": "Debug koi-editor",
    "build": {
      "command": "xmake",
      "args": ["build", "koi-editor"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/windows/x64/debug/koi-editor.exe",
    "args": [
    	"-p", "$ZED_WORKTREE_ROOT/Sandbox/Sandbox.toml",
     	"--engine-source", "$ZED_WORKTREE_ROOT/Engine",
      "--project-source", "$ZED_WORKTREE_ROOT/Sandbox/"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/build/windows/x64/debug",
    "request": "launch",
    "adapter": "CodeLLDB",
  }
]
